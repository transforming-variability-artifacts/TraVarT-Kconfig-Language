config CPU_32
	bool
	default y

config CPU_ARM610
	bool "Support ARM610 processor"
	depends on ARCH_RPC
	select CPU_32v3 & CPU_CACHE_V3 & CPU_COPY_V3 & CPU_TLB_V3

# Auxiliary ifs removed
config CPU_ARM710
	bool "Support ARM710 processor"
	default y
	select CPU_32v3 & CPU_CACHE_V3 & CPU_COPY_V3 & CPU_TLB_V3

# Auxiliary ifs removed
config CPU_ARM720T
	bool "Support ARM720T processor"
	default y
	select CPU_32v4 & CPU_ABRT_LV4T & CPU_CACHE_V4 & CPU_COPY_V4WT & CPU_TLB_V4WT

config CPU_ARM920T
	bool "Support ARM920T processor"
	depends on ARCH_INTEGRATOR | ARCH_S3C2410 | ARCH_IMX
	default y
	select CPU_32v4 & CPU_ABRT_EV4T & CPU_CACHE_V4WT & CPU_COPY_V4WB & CPU_TLB_V4WBI

config CPU_ARM922T
	bool
	depends on ARCH_CAMELOT | ARCH_LH7A40X
	default y
	select CPU_32v4 & CPU_ABRT_EV4T & CPU_CACHE_V4WT & CPU_COPY_V4WB & CPU_TLB_V4WBI

config CPU_ARM925T
	bool
	depends on ARCH_OMAP1510
	default y
	select CPU_32v4 & CPU_ABRT_EV4T & CPU_CACHE_V4WT & CPU_COPY_V4WB & CPU_TLB_V4WBI

config CPU_ARM926T
	bool "Support ARM926T processor"
	depends on ARCH_INTEGRATOR | ARCH_VERSATILE_PB | ARCH_OMAP730 | ARCH_OMAP1610 | ARCH_OMAP5912
	default y
	select CPU_32v5 & CPU_ABRT_EV5TJ & CPU_COPY_V4WB & CPU_TLB_V4WBI

config CPU_ARM1020
	bool "Support ARM1020T (rev 0) processor"
	depends on ARCH_INTEGRATOR
	select CPU_32v5 & CPU_ABRT_EV4T & CPU_CACHE_V4WT & CPU_COPY_V4WB & CPU_TLB_V4WBI

config CPU_ARM1020E
	bool "Support ARM1020E processor"
	depends on ARCH_INTEGRATOR
	depends on $false
	select CPU_32v5 & CPU_ABRT_EV4T & CPU_CACHE_V4WT & CPU_COPY_V4WB & CPU_TLB_V4WBI

config CPU_ARM1022
	bool "Support ARM1022E processor"
	depends on ARCH_INTEGRATOR
	select CPU_32v5 & CPU_ABRT_EV4T & CPU_COPY_V4WB  & CPU_TLB_V4WBI

config CPU_ARM1026
	bool "Support ARM1026EJ-S processor"
	depends on ARCH_INTEGRATOR
	select CPU_32v5 & CPU_ABRT_EV5T & CPU_COPY_V4WB & CPU_TLB_V4WBI

config CPU_SA110
	bool "Support StrongARM(R) SA-110 processor"
	default y
	select CPU_ABRT_EV4 & CPU_CACHE_V4WB & CPU_COPY_V4WB & CPU_TLB_V4WB

config CPU_SA1100
	bool
	depends on ARCH_SA1100
	default y
	select CPU_32v4 & CPU_ABRT_EV4 & CPU_CACHE_V4WB & CPU_TLB_V4WB &CPU_MINICACHE

config CPU_XSCALE
	bool
	depends on ARCH_IOP3XX | ARCH_PXA | ARCH_IXP4XX | ARCH_IXP2000
	default y
	select CPU_32v5 & CPU_ABRT_EV5T & CPU_TLB_V4WBI & CPU_MINICACHE

config CPU_V6
	bool "Support ARM V6 processor"
	depends on ARCH_INTEGRATOR
	select CPU_32v6 & CPU_ABRT_EV6 & CPU_CACHE_V6 & CPU_COPY_V6 & CPU_TLB_V6

config CPU_32v3
	bool

config CPU_32v4
	bool

config CPU_32v5
	bool

config CPU_32v6
	bool

config CPU_ABRT_EV4
	bool

config CPU_ABRT_EV4T
	bool

config CPU_ABRT_LV4T
	bool

config CPU_ABRT_EV5T
	bool

config CPU_ABRT_EV5TJ
	bool

config CPU_ABRT_EV6
	bool

config CPU_CACHE_V3
	bool

config CPU_CACHE_V4
	bool

config CPU_CACHE_V4WT
	bool

config CPU_CACHE_V4WB
	bool

config CPU_CACHE_V6
	bool

config CPU_COPY_V3
	bool

config CPU_COPY_V4WT
	bool

config CPU_COPY_V4WB
	bool

config CPU_COPY_V6
	bool

config CPU_TLB_V3
	bool

config CPU_TLB_V4WT
	bool

config CPU_TLB_V4WB
	bool

config CPU_TLB_V4WBI
	bool

config CPU_TLB_V6
	bool

config CPU_MINICACHE
	bool

config ARM_THUMB
	bool "Support Thumb user binaries"
	depends on CPU_ARM720T | CPU_ARM920T | CPU_ARM922T | CPU_ARM925T | CPU_ARM926T | CPU_ARM1020 | CPU_ARM1020E | CPU_ARM1022 | CPU_ARM1026 | CPU_XSCALE | CPU_V6
	default y

config CPU_BIG_ENDIAN
	bool "Build big-endian kernel"
	depends on ARCH_SUPPORTS_BIG_ENDIAN

config CPU_ICACHE_DISABLE
	bool "Disable I-Cache"
	depends on CPU_ARM920T | CPU_ARM922T | CPU_ARM925T | CPU_ARM926T | CPU_ARM1020

config CPU_DCACHE_DISABLE
	bool "Disable D-Cache"
	depends on CPU_ARM920T | CPU_ARM922T | CPU_ARM925T | CPU_ARM926T | CPU_ARM1020

config CPU_DCACHE_WRITETHROUGH
	bool "Force write through D-cache"
	depends on (CPU_ARM920T | CPU_ARM922T | CPU_ARM925T | CPU_ARM926T | CPU_ARM1020) & ~CPU_DISABLE_DCACHE

config CPU_CACHE_ROUND_ROBIN
	bool "Round robin I and D cache replacement algorithm"
	depends on (CPU_ARM926T | CPU_ARM1020) & (~CPU_ICACHE_DISABLE | ~CPU_DCACHE_DISABLE)

config CPU_BPREDICT_DISABLE
	bool "Disable branch prediction"
	depends on CPU_ARM1020

config ARCH_CAMELOT
	bool
	default n

