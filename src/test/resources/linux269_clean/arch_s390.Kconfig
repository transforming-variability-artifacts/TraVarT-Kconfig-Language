
config MMU
	bool
	default y

config RWSEM_GENERIC_SPINLOCK
	bool

config RWSEM_XCHGADD_ALGORITHM
	bool
	default y

config GENERIC_BUST_SPINLOCK
	bool

mainmenu LKC

config ARCH_S390
	bool
	default y

config UID16
	bool
	default y
	depends on ~ARCH_S390X

menu BASE

config ARCH_S390X
	bool "64 bit kernel"
	select ARCH_64BIT

config ARCH_64BIT
	bool 	

config ARCH_S390_31
	bool
	depends on ~ARCH_S390X
	default y

config SMP
	bool "Symmetric multi-processing support"

config HOTPLUG_CPU
	bool "Support for hot-pluggable CPUs (EXPERIMENTAL)"
	depends on SMP & HOTPLUG & EXPERIMENTAL
	default n

config MATHEMU
	bool "IEEE FPU emulation"
	depends on MARCH_G5

config S390_SUPPORT
	bool "Kernel support for 31 bit emulation"
	depends on ARCH_S390X

config COMPAT
	bool
	depends on S390_SUPPORT
	default y

config SYSVIPC_COMPAT
	bool
	depends on COMPAT & SYSVIPC
	default y

config BINFMT_ELF32
	tristate "Kernel support for 31 bit ELF binaries"
	depends on S390_SUPPORT

choice PROCESSOR_TYPE
	bool "Processor type"
	default MARCH_G5

config MARCH_G5
	bool "S/390 model G5 and G6"
	depends on ARCH_S390_31

config MARCH_Z900
	bool "IBM eServer zSeries model z800 and z900"

config MARCH_Z990
	bool "IBM eServer zSeries model z890 and z990"

endchoice

config PACK_STACK
	bool "Pack kernel stack"

config SMALL_STACK
	bool "Use 4kb/8kb for kernel stack instead of 8kb/16kb"
	depends on PACK_STACK

config CHECK_STACK
	bool "Detect kernel stack overflow"


config WARN_STACK
	bool "Emit compiler warnings for function with broken stack usage"

config MACHCHK_WARNING
	bool "Process warning machine checks"

config QDIO
	tristate "QDIO support"

config QDIO_PERF_STATS
	bool "Performance statistics in /proc"
	depends on QDIO

config QDIO_DEBUG
	bool "Extended debugging information"
	depends on QDIO

config PREEMPT
	bool "Preemptible Kernel"

config IPL
	bool "Builtin IPL record support"

choice IPL_METHOD
	bool "IPL method generated into head.S"
	depends on IPL
	default IPL_TAPE

config IPL_TAPE
	bool "tape"

config IPL_VM
	bool "vm_reader"

endchoice


config PROCESS_DEBUG
	bool "Show crashed user process info"

config PFAULT
	bool "Pseudo page fault support"

config SHARED_KERNEL
	bool "VM shared kernel support"

config CMM
	tristate "Cooperative memory management"

config CMM_PROC
	bool "/proc interface to cooperative memory management"
	depends on CMM

config CMM_IUCV
	bool "IUCV special message interface to cooperative memory management"
	depends on CMM & (SMSGIUCV | ((CMM & SMSGIUCV) | (~CMM & ~SMSGIUCV)))

config VIRT_TIMER
	bool "Virtual CPU timer support"

config APPLDATA_BASE
	bool "Linux - VM Monitor Stream, base infrastructure"
	depends on PROC_FS & VIRT_TIMER

config APPLDATA_MEM
	tristate "Monitor memory management statistics"
	depends on APPLDATA_BASE

config APPLDATA_OS
	tristate "Monitor OS statistics"
	depends on APPLDATA_BASE

config APPLDATA_NET_SUM
	tristate "Monitor overall network statistics"
	depends on APPLDATA_BASE

config NO_IDLE_HZ
	bool "No HZ timer ticks in idle"

config NO_IDLE_HZ_INIT
	bool "HZ timer in idle off by default"
	depends on NO_IDLE_HZ

endmenu

config PCMCIA
	bool
	default n











