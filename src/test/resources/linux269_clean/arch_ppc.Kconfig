menu MENU_BUS

config ISA
	bool "Support for ISA-bus hardware"
	depends on PPC_PREP | PPC_CHRP

config GENERIC_ISA_DMA
	bool
	depends on POWER3 | POWER4 | CPU_6XX & ~CPM2
	default y

config EISA
	bool

config SBUS
	bool

config MCA
	bool

# Removed default statements
# Multiple auxiliary ifs omitted
config PCI
	bool "PCI support"

config PCI_DOMAINS
	bool
	default PCI

config PCI_QSPAN
	bool "QSpan PCI"
	depends on ~CPU_4XX & ~CPM2 & CPU_8XX

config PCI_8260
	bool
	depends on PCI & MB_8260 & ~MB_8272
	default y

config PCI_8260_PCI9
	bool "  Enable workaround for MPC826x erratum PCI 9"
	depends on PCI_8260
	default y

choice PCI_8260_PCI9_IDMA
	bool "  IDMA channel for PCI 9 workaround"
	depends on PCI_8260_PCI9

config 8260_PCI9_IDMA1
	bool "IDMA1"

config 8260_PCI9_IDMA2
	bool "IDMA2"

config 8260_PCI9_IDMA3
	bool "IDMA3"

config 8260_PCI9_IDMA4
	bool "IDMA4"

endchoice

config PCI_PERMEDIA
	bool "PCI for Permedia2"
	depends on ~CPU_4XX & ~CPU_8XX & APUS

endmenu

menu MENU_ADV

config ADVANCED_OPTIONS
	bool "Prompt for advanced kernel configuration options"

comment "Default settings for advanced configuration options are used"
	depends on ~ADVANCED_OPTIONS

config HIGHMEM_START_BOOL
	bool "Set high memory pool address"
	depends on ADVANCED_OPTIONS & HIGHMEM

config LOWMEM_SIZE_BOOL
	bool "Set maximum low memory"
	depends on ADVANCED_OPTIONS

config KERNEL_START_BOOL
	bool "Set custom kernel base address"
	depends on ADVANCED_OPTIONS

config TASK_SIZE_BOOL
	bool "Set custom user task size"
	depends on ADVANCED_OPTIONS


config CONSISTENT_START_BOOL
	bool "Set custom consistent memory pool address"
	depends on ADVANCED_OPTIONS & NOT_COHERENT_CACHE

config CONSISTENT_SIZE_BOOL
	bool "Set custom consistent memory pool size"
	depends on ADVANCED_OPTIONS & NOT_COHERENT_CACHE

config BOOT_LOAD_BOOL
	bool "Set the boot link/load address"
	depends on ADVANCED_OPTIONS & ~PPC_MULTIPLATFORM

config PIN_TLB
	bool "Pinned Kernel TLBs (860 ONLY)"
	depends on ADVANCED_OPTIONS & CPU_8XX
endmenu

# Double enclosure, add dummy confsym
