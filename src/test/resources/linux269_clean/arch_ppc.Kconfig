# Omitted auxiliary ifs
config PPCBUG_NVRAM
	bool "Enable reading PPCBUG NVRAM during boot"
	default y

config SMP
	bool "Symmetric multi-processing support"

config IRQ_ALL_CPUS
	bool "Distribute interrupts on all CPUs by default"
