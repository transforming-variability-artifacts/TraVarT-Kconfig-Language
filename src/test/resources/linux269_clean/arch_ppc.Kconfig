menu MENU_PROCESSOR

# Configuration symbols renamed CPU_*
choice PROCESSOR_TYPE
	bool "Processor Type"
	default CPU_6XX

config CPU_6XX
	bool "6xx/7xx/74xx/52xx/8260"

config CPU_40X
	bool "40x"

config CPU_44X
	bool "44x"

config POWER3
	bool "POWER3"

config POWER4
	bool "POWER4 and 970 (G5)"

config CPU_8XX
	bool "8xx"

config E500
	bool "e500"

endchoice

config BOOKE
	bool
	depends on E500
	default y

config FSL_BOOKE
	bool
	depends on E500
	default y

config PTE_64BIT
	bool
	depends on CPU_44X
	default y

config ALTIVEC
	bool "AltiVec Support"
	depends on CPU_6XX | POWER4
	depends on ~MB_8260

config SPE
	bool "SPE Support"
	depends on E500

config TAU
	bool "Thermal Management Support"
	depends on CPU_6XX & ~MB_8260

config TAU_INT
	bool "Interrupt driven TAU driver (DANGEROUS)"
	depends on TAU

config TAU_AVERAGE
	bool "Average high and low temp"
	depends on TAU

config MATH_EMULATION
	bool "Math emulation"
	depends on CPU_4XX | CPU_8XX | E500

config CPU_FREQ
	bool "CPU Frequency scaling"

config CPU_FREQ_PMAC
	bool "Support for Apple PowerBooks"
	depends on CPU_FREQ & ADB_PMU

config CPU_FREQ_TABLE
	bool
	depends on CPU_FREQ_PMAC
	default y

config PPC601_SYNC_FIX
	bool "Workarounds for PPC601 bugs"
	depends on CPU_6XX & (PPC_PREP | PPC_PMAC)

config PPC64BRIDGE
	bool
	depends on POWER3 | POWER4
	default y

config PPC_STD_MMU
	bool
	depends on CPU_6XX | POWER3 | POWER4
	default y

config NOT_COHERENT_CACHE
	bool
	depends on CPU_4XX | CPU_8XX
	default y

endmenu

