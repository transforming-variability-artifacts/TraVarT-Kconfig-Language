# Very simple if block with literal expression should work
if ARCH_OMAP

menu TI_OMAP_IMPL

config ARCH_OMAP730
	bool "OMAP730 Based System"
	select CPU_ARM926T

config ARCH_OMAP1510
	default y
	bool "OMAP1510 Based System"
	select CPU_ARM925T
	select CPU_DCACHE_WRITETHROUGH

config ARCH_OMAP1610
	bool "OMAP1610 Based System"
	select CPU_ARM926T

config ARCH_OMAP5912
	bool "OMAP5912 Based System"
	select CPU_ARM926T

config MACH_OMAP_INNOVATOR
	bool "TI Innovator"
	default y
	depends on ARCH_OMAP1510 | ARCH_OMAP1610

config MACH_OMAP_H2
	bool "TI H2 Support"
	depends on ARCH_OMAP1610
	select MACH_OMAP_INNOVATOR

config MACH_OMAP_H3
	bool "TI H3 Support"
	depends on ARCH_OMAP1610

config MACH_OMAP_H4
	bool "TI H4 Support"
	depends on ARCH_OMAP1610

config MACH_OMAP_OSK
	bool "TI OSK Support"
	depends on ARCH_OMAP5912

config MACH_OMAP_PERSEUS2
	bool "TI Perseus2"
	depends on ARCH_OMAP730
	select LEDS
	select LEDS_TIMER
	select LEDS_CPU

config MACH_OMAP_GENERIC
	bool "Generic OMAP board"
	depends on ARCH_OMAP1510 | ARCH_OMAP1610

config OMAP_MUX
	bool "OMAP multiplexing support"
	default y

config OMAP_MUX_DEBUG
	bool "Multiplexing debug output"
	depends on OMAP_MUX
	default n

choice OMAP_LL_DEBUG
	bool
	default OMAP_LL_DEBUG_UART1

config OMAP_LL_DEBUG_UART1
	bool "UART1"

config OMAP_LL_DEBUG_UART2
	bool "UART2"

config OMAP_LL_DEBUG_UART3
	bool "UART3"

endchoice

config OMAP_ARM_195MHZ
	bool "OMAP ARM 195 MHz CPU"
	depends on ARCH_OMAP730

config OMAP_ARM_192MHZ
	bool "OMAP ARM 192 MHz CPU"
	depends on ARCH_OMAP1610 | ARCH_OMAP5912

config OMAP_ARM_182MHZ
	bool "OMAP ARM 182 MHz CPU"
	depends on ARCH_OMAP730

config OMAP_ARM_168MHZ
	bool "OMAP ARM 168 MHz CPU"
	depends on ARCH_OMAP1510 | ARCH_OMAP1610 | ARCH_OMAP730 | ARCH_OMAP5912

config OMAP_ARM_120MHZ
	bool "OMAP ARM 120 MHz CPU"
	depends on ARCH_OMAP1510 | ARCH_OMAP1610 | ARCH_OMAP730

config OMAP_ARM_60MHZ
	bool "OMAP ARM 60 MHz CPU"
	depends on ARCH_OMAP1510 | ARCH_OMAP1610 | ARCH_OMAP730
	default y

config OMAP_ARM_30MHZ
	bool "OMAP ARM 30 MHz CPU"
	depends on ARCH_OMAP1510 | ARCH_OMAP1610 | ARCH_OMAP730

endmenu

endif

config ARCH_OMAP
	bool
	default n

config CPU_ARM925T
	bool
	default n

config CPU_ARM926T
	bool
	default n

config CPU_DCACHE_WRITETHROUGH
	bool
	default n

config LEDS
	bool
	default n

config LEDS_CPU
	bool
	default n

config LEDS_TIMER
	bool
	default n

