mainmenu MENU_LKC

config X86
	bool
	default y

config MMU
	bool
	default y

config SBUS
	bool

config UID16
	bool
	default y

config GENERIC_ISA_DMA
	bool
	default y

config GENERIC_IOMAP
	bool
	default y

menu MENU_PROC_TYPE

choice SUBARCH
	bool "Subarchitecture Type"
	default X86_PC

config X86_PC
	bool "PC-compatible"

config X86_ELAN
	bool "AMD Elan"

config X86_VOYAGER
	bool "Voyager (NCR)"

config X86_NUMAQ
	bool "NUMAQ (IBM/Sequent)"
	select DISCONTIGMEM & NUMA

config X86_SUMMIT
	bool "Summit/EXA (IBM x440)"
	depends on SMP

config X86_BIGSMP
	bool "Support for other sub-arch SMP systems with more than 8 CPUs"
	depends on SMP

config X86_VISWS
	bool "SGI 320/540 (Visual Workstation)"

config X86_GENERICARCH
	bool "Generic architecture (Summit, bigsmp, ES7000, default)"
	depends on SMP

config X86_ES7000
	bool "Support for Unisys ES7000 IA32 series"
	depends on SMP

endchoice

config ACPI_SRAT
	bool
	default y
	depends on NUMA & (X86_SUMMIT | X86_GENERICARCH)

config X86_SUMMIT_NUMA
	bool
	default y
	depends on NUMA & (X86_SUMMIT | X86_GENERICARCH)

config X86_CYCLONE_TIMER
	bool
	default y
	depends on X86_SUMMIT | X86_GENERICARCH

config ES7000_CLUSTERED_APIC
	bool
	default y
	depends on SMP & X86_ES7000 & MPENTIUMIII

# if block factorized as dependencies
choice PROCESSOR_FAMILY
	bool "Processor family"
	depends on ~X86_ELAN
	default M686

config M386
	bool "386"

config M486
	bool "486"

config M586
	bool "586/K5/5x86/6x86/6x86MX"

config M586TSC
	bool "Pentium-Classic"

config M586MMX
	bool "Pentium-MMX"

config M686
	bool "Pentium-Pro"

config MPENTIUMII
	bool "Pentium-II/Celeron(pre-Coppermine)"

config MPENTIUMIII
	bool "Pentium-III/Celeron(Coppermine)/Pentium-III Xeon"

config MPENTIUMM
	bool "Pentium M"

config MPENTIUM4
	bool "Pentium-4/Celeron(P4-based)/Pentium-4 M/Xeon"

config MK6
	bool "K6/K6-II/K6-III"

config MK7
	bool "Athlon/Duron/K7"

config MK8
	bool "Opteron/Athlon64/Hammer/K8"

config MCRUSOE
	bool "Crusoe"

config MWINCHIPC6
	bool "Winchip-C6"

config MWINCHIP2
	bool "Winchip-2"

config MWINCHIP3D
	bool "Winchip-2A/Winchip-3"

config MCYRIXIII
	bool "CyrixIII/VIA-C3"

config MVIAC3_2
	bool "VIA C3-2 (Nehemiah)"

endchoice

config X86_GENERIC
	bool "Generic x86 support"
	depends on ~X86_ELAN

config X86_CMPXCHG
	bool
	depends on ~M386
	default y

config X86_XADD
	bool
	depends on ~M386
	default y

config RWSEM_GENERIC_SPINLOCK
	bool
	depends on M386
	default y

config RWSEM_XCHGADD_ALGORITHM
	bool
	depends on ~M386
	default y

config X86_PPRO_FENCE
	bool
	depends on M686 | M586MMX | M586TSC | M586 | M486 | M386
	default y

config X86_F00F_BUG
	bool
	depends on M586MMX | M586TSC | M586 | M486 | M386
	default y

config X86_WP_WORKS_OK
	bool
	depends on ~M386
	default y

config X86_INVLPG
	bool
	depends on ~M386
	default y

config X86_BSWAP
	bool
	depends on ~M386
	default y

config X86_POPAD_OK
	bool
	depends on ~M386
	default y

config X86_ALIGNMENT_16
	bool
	depends on MWINCHIP3D | MWINCHIP2 | MWINCHIPC6 | MCYRIXIII | X86_ELAN | MK6 | M586MMX | M586TSC | M586 | M486 | MVIAC3_2
	default y

config X86_GOOD_APIC
	bool
	depends on MK7 | MPENTIUM4 | MPENTIUMM | MPENTIUMIII | MPENTIUMII | M686 | M586MMX | MK8
	default y

config X86_INTEL_USERCOPY
	bool
	depends on MPENTIUM4 | MPENTIUMM | MPENTIUMIII | MPENTIUMII | M586MMX | X86_GENERIC | MK8 | MK7
	default y

config X86_USE_PPRO_CHECKSUM
	bool
	depends on MWINCHIP3D | MWINCHIP2 | MWINCHIPC6 | MCYRIXIII | MK7 | MK6 | MPENTIUM4 | MPENTIUMM | MPENTIUMIII | MPENTIUMII | M686 | MK8 | MVIAC3_2
	default y

config X86_USE_3DNOW
	bool
	depends on MCYRIXIII | MK7
	default y

config X86_OOSTORE
	bool
	depends on (MWINCHIP3D | MWINCHIP2 | MWINCHIPC6) & MTRR
	default y

config HPET_TIMER
	bool "HPET Timer Support"

config HPET_EMULATE_RTC
	bool "Provide RTC interrupt"
	depends on HPET_TIMER & RTC

config SMP
	bool "Symmetric multi-processing support"

config SCHED_SMT
	bool "SMT (Hyperthreading) scheduler support"
	depends on SMP
	default off

config PREEMPT
	bool "Preemptible Kernel"

config X86_UP_APIC
	bool "Local APIC support on uniprocessors"
	depends on ~(X86_VISWS | X86_VOYAGER)

config X86_UP_IOAPIC
	bool "IO-APIC support on uniprocessors"
	depends on ~SMP & X86_UP_APIC

config X86_LOCAL_APIC
	bool
	depends on ~SMP & X86_UP_APIC
	default y

config X86_IO_APIC
	bool
	depends on ~SMP & X86_UP_IOAPIC
	default y

config X86_TSC
	bool
	depends on (MWINCHIP3D | MWINCHIP2 | MCRUSOE | MCYRIXIII | MK7 | MK6 | MPENTIUM4 | MPENTIUMM | MPENTIUMIII | MPENTIUMII | M686 | M586MMX | M586TSC | MK8 | MVIAC3_2) & ~X86_NUMAQ
	default y

config X86_MCE
	bool "Machine Check Exception"
	depends on ~X86_VOYAGER

config X86_MCE_NONFATAL
	tristate "Check for non-fatal errors on AMD Athlon/Duron / Intel Pentium 4"
	depends on X86_MCE

config X86_MCE_P4THERMAL
	bool "check for P4 thermal throttling interrupt."
	depends on X86_MCE & (X86_UP_APIC | SMP)

config TOSHIBA
	tristate "Toshiba Laptop support"

config I8K
	tristate "Dell laptop support"

config MICROCODE
	tristate "/dev/cpu/microcode - Intel IA32 CPU microcode support"

config X86_MSR
	tristate "/dev/cpu/*/msr - Model-specific register support"

config X86_CPUID
	tristate "/dev/cpu/*/cpuid - CPU information support"

choice HIGHMEM_TYPE
	bool "High Memory Support"
	default NOHIGHMEM

config NOHIGHMEM
	bool "off"

config HIGHMEM4G
	bool "4GB"

config HIGHMEM64G
	bool "64GB"

endchoice

config HIGHMEM
	bool
	depends on HIGHMEM64G | HIGHMEM4G
	default y

config X86_PAE
	bool
	depends on HIGHMEM64G
	default y

# Omitted default values
config NUMA
	bool "Numa Memory Allocation and Scheduler Support"
	depends on SMP & HIGHMEM64G & (X86_NUMAQ | X86_GENERICARCH | (X86_SUMMIT & ACPI))

comment "NUMA (NUMA-Q) requires SMP, 64GB highmem support"
	depends on X86_NUMAQ & (~HIGHMEM64G | ~SMP)

comment "NUMA (Summit) requires SMP, 64GB highmem support, ACPI"
	depends on X86_SUMMIT & (~HIGHMEM64G | ~ACPI)

config DISCONTIGMEM
	bool
	depends on NUMA
	default y

config HAVE_ARCH_BOOTMEM_NODE
	bool
	depends on NUMA
	default y

config HIGHPTE
	bool "Allocate 3rd-level pagetables from highmem"
	depends on HIGHMEM4G | HIGHMEM64G

config MATH_EMULATION
	bool "Math emulation"

config MTRR
	bool "MTRR (Memory Type Range Register) support"

config EFI
	bool "Boot from EFI support (EXPERIMENTAL)"
	depends on ACPI
	default n

config IRQBALANCE
	bool "Enable kernel irq balancing"
	depends on SMP & X86_IO_APIC
	default y

config HAVE_DEC_LOCK
	bool
	depends on (SMP | PREEMPT) & X86_CMPXCHG
	default y

config BOOT_IOREMAP
	bool
	depends on (((X86_SUMMIT | X86_GENERICARCH) & NUMA) | (X86 & EFI))
	default y

config REGPARM
	bool "Use register arguments (EXPERIMENTAL)"
	depends on EXPERIMENTAL
	default n

endmenu

menu MENU_BUS

config X86_VISWS_APIC
	bool
	depends on X86_VISWS
	default y

# Renamed to *_BUS
config X86_LOCAL_APIC_BUS
	bool
	depends on (X86_VISWS | SMP) & ~X86_VOYAGER
	default y

# Renamed to *_BUS
config X86_IO_APIC_BUS
	bool
	depends on SMP & ~(X86_VISWS | X86_VOYAGER)
	default y

# Omitted default value
config PCI
	bool "PCI support" if !X86_VISWS
	depends on ~X86_VOYAGER

choice PCI_GO_TYPE
	bool "PCI access mode"
	depends on PCI & ~X86_VISWS
	default PCI_GOANY

config PCI_GOBIOS
	bool "BIOS"

config PCI_GOMMCONFIG
	bool "MMConfig"

config PCI_GODIRECT
	bool "Direct"

config PCI_GOANY
	bool "Any"

endchoice

config PCI_BIOS
	bool
	depends on ~X86_VISWS & PCI & (PCI_GOBIOS | PCI_GOANY)
	default y

config PCI_DIRECT
	bool
	depends on PCI & ((PCI_GODIRECT | PCI_GOANY) | X86_VISWS)
	default y

config PCI_MMCONFIG
	bool
	depends on PCI & (PCI_GOMMCONFIG | (PCI_GOANY & ACPI))
	select ACPI_BOOT
	default y

config ISA
	bool "ISA support"
	depends on ~(X86_VOYAGER | X86_VISWS)

config EISA
	bool "EISA support"
	depends on ISA

config MCA
	bool "MCA support"
	depends on ~(X86_VISWS | X86_VOYAGER)

config SCx200
	tristate "NatSemi SCx200 support"
	depends on ~X86_VOYAGER

endmenu

config X86_SMP
	bool
	depends on SMP & ~X86_VOYAGER
	default y

config X86_HT
	bool
	depends on SMP & ~(X86_VISWS | X86_VOYAGER)
	default y

config X86_BIOS_REBOOT
	bool
	depends on ~(X86_VISWS | X86_VOYAGER)
	default y

config X86_TRAMPOLINE
	bool
	depends on X86_SMP | (X86_VOYAGER & SMP)
	default y

config PC
	bool
	depends on X86 & ~EMBEDDED
	default y

config ACPI
	bool
	default n

config ACPI_BOOT
	bool
	default n

config EMBEDDED
	bool
	default n

config EXPERIMENTAL
	bool
	default n

config PM
	bool
	default n

config RTC
	bool
	default n

