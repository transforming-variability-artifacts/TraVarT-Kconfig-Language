# Omit default statements with auxiliary if
config PARIDE_PARPORT
	tristate
	depends on PARIDE

comment "Parallel IDE high-level drivers"
	depends on PARIDE

config PARIDE_PD
	tristate "Parallel port IDE disks"
	depends on PARIDE

config PARIDE_PCD
	tristate "Parallel port ATAPI CD-ROMs"
	depends on PARIDE

config PARIDE_PF
	tristate "Parallel port ATAPI disks"
	depends on PARIDE

config PARIDE_PT
	tristate "Parallel port ATAPI tapes"
	depends on PARIDE

config PARIDE_PG
	tristate "Parallel port generic ATAPI devices"
	depends on PARIDE

comment "Parallel IDE protocol modules"
	depends on PARIDE

config PARIDE_ATEN
	tristate "ATEN EH-100 protocol"
	depends on PARIDE

config PARIDE_BPCK
	tristate "MicroSolutions backpack (Series 5) protocol"
	depends on PARIDE

config PARIDE_BPCK6
	tristate "MicroSolutions backpack (Series 6) protocol"
	depends on PARIDE & ~ARCH_64BIT

config PARIDE_COMM
	tristate "DataStor Commuter protocol"
	depends on PARIDE

config PARIDE_DSTR
	tristate "DataStor EP-2000 protocol"
	depends on PARIDE

config PARIDE_FIT2
	tristate "FIT TD-2000 protocol"
	depends on PARIDE

config PARIDE_FIT3
	tristate "FIT TD-3000 protocol"
	depends on PARIDE

config PARIDE_EPAT
	tristate "Shuttle EPAT/EPEZ protocol"
	depends on PARIDE

config PARIDE_EPATC8
	bool "Support c7/c8 chips (EXPERIMENTAL)"
	depends on PARIDE_EPAT & EXPERIMENTAL

config PARIDE_EPIA
	tristate "Shuttle EPIA protocol"
	depends on PARIDE

config PARIDE_FRIQ
	tristate "Freecom IQ ASIC-2 protocol"
	depends on PARIDE

config PARIDE_FRPW
	tristate "FreeCom power protocol"
	depends on PARIDE

config PARIDE_KBIC
	tristate "KingByte KBIC-951A/971A protocols"
	depends on PARIDE

config PARIDE_KTTI
	tristate "KT PHd protocol"
	depends on PARIDE

config PARIDE_ON20
	tristate "OnSpec 90c20 protocol"
	depends on PARIDE

config PARIDE_ON26
	tristate "OnSpec 90c26 protocol"
	depends on PARIDE

config EXPERIMENTAL
	bool
	default n

config PARIDE
	bool
	default n

