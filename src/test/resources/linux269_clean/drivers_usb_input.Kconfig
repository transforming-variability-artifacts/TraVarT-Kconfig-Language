config USB_HID
	tristate "USB Human Interface Device (full HID) support"
	depends on USB

config USB_HIDINPUT
	bool "HID input layer support"
	default y
	depends on INPUT & USB_HID

config HID_FF
	bool "Force feedback support (EXPERIMENTAL)"
	depends on USB_HIDINPUT & EXPERIMENTAL

config HID_PID
	bool "PID Devices (Microsoft Sidewinder Force Feedback 2)"
	depends on HID_FF

config LOGITECH_FF
	bool "Logitech WingMan *3D support"
	depends on HID_FF

config THRUSTMASTER_FF
	bool "ThrustMaster FireStorm Dual Power 2 support (EXPERIMENTAL)"
	depends on HID_FF & EXPERIMENTAL

config USB_HIDDEV
	bool "/dev/hiddev raw HID device support"
	depends on USB_HID

menu MENU_USB_HIDBP
	depends on USB & !USB_HID

config USB_KBD
	tristate "USB HIDBP Keyboard (simple Boot) support"
	depends on USB & INPUT

config USB_MOUSE
	tristate "USB HIDBP Mouse (simple Boot) support"
	depends on USB & INPUT

endmenu

config USB_AIPTEK
	tristate "Aiptek 6000U/8000U tablet support"
	depends on USB & INPUT

config USB_WACOM
	tristate "Wacom Intuos/Graphire tablet support"
	depends on USB & INPUT

config USB_KBTAB
	tristate "KB Gear JamStudio tablet support"
	depends on USB & INPUT

config USB_POWERMATE
	tristate "Griffin PowerMate and Contour Jog support"
	depends on USB & INPUT

config USB_MTOUCH
	tristate "MicroTouch USB Touchscreen Driver"
	depends on USB & INPUT

config USB_EGALAX
	tristate "eGalax TouchKit USB Touchscreen Driver"
	depends on USB & INPUT

config USB_XPAD
	tristate "X-Box gamepad support"
	depends on USB & INPUT

config USB_ATI_REMOTE
	tristate "ATI / X10 USB RF remote control"
	depends on USB & INPUT

config EXPERIMENTAL
	bool
	default n

config INPUT
	bool
	default n

config USB
	bool
	default n

