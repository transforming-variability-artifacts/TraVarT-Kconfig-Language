menu MENU_PARPORT

config PARPORT
	tristate "Parallel port support"

config PARPORT_PC
	tristate "PC-style hardware"
	depends on PARPORT & (~SPARC64 | PCI)

config PARPORT_PC_CML1
	tristate
	depends on PARPORT & PARPORT_PC
	default m # Complex default expression omitted

config PARPORT_SERIAL
	tristate "Multi-IO cards (parallel and serial)"
	depends on SERIAL_8250 & PARPORT_PC_CML1 & PCI

config PARPORT_PC_FIFO
	bool "Use FIFO/DMA if available (EXPERIMENTAL)"
	depends on PARPORT_PC & EXPERIMENTAL

config PARPORT_PC_SUPERIO
	bool "SuperIO chipset support (EXPERIMENTAL)"
	depends on PARPORT_PC & EXPERIMENTAL

config PARPORT_PC_PCMCIA
	tristate "Support for PCMCIA management for PC-style ports"
	depends on PARPORT & HOTPLUG & (PCMCIA & PARPORT_PC)

config PARPORT_ARC
	tristate "Archimedes hardware"
	depends on ARM & PARPORT

config PARPORT_AMIGA
	tristate "Amiga builtin port"
	depends on AMIGA & PARPORT

config PARPORT_MFC3
	tristate "Multiface III parallel port"
	depends on ZORRO & PARPORT

config PARPORT_ATARI
	tristate "Atari hardware"
	depends on ATARI & PARPORT

config PARPORT_GSC
	tristate
	depends on GSC
	default PARPORT

config PARPORT_SUNBPP
	tristate "Sparc hardware (EXPERIMENTAL)"
	depends on SBUS & EXPERIMENTAL & PARPORT

config PARPORT_OTHER
	bool "Support foreign hardware"
	depends on PARPORT

config PARPORT_1284
	bool "IEEE 1284 transfer modes"
	depends on PARPORT

endmenu

config AMIGA
	bool
	default n

config ARM
	bool
	default n

config ATARI
	bool
	default n

config EXPERIMENTAL
	bool
	default n

config GSC
	bool
	default n

config HOTPLUG
	bool
	default n

config PCI
	bool
	default n

config PCMCIA
	bool
	default n

config SBUS
	bool
	default n

config SERIAL_8250
	bool
	default n

config SPARC64
	bool
	default n

config ZORRO
	bool
	default n

