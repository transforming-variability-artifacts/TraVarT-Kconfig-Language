menu MENU_CODE

config EXPERIMENTAL
	bool "Prompt for development and/or incomplete code/drivers"

config CLEAN_COMPILE # visibility if omitted
	bool "Select only drivers expected to compile cleanly"
	default y

config BROKEN
	bool
	depends on ~CLEAN_COMPILE
	default y

config BROKEN_ON_SMP
	bool
	depends on BROKEN | ~SMP
	default y

endmenu

menu MENU_GENERAL

config SWAP
	bool "Support for paging of anonymous memory (swap)"
	depends on MMU
	default y

config SYSVIPC
	bool "System V IPC"
	depends on MMU

config POSIX_MQUEUE
	bool "POSIX Message Queues"
	depends on NET & EXPERIMENTAL

config BSD_PROCESS_ACCT
	bool "BSD Process Accounting"

config BSD_PROCESS_ACCT_V3
	bool "BSD Process Accounting version 3 file format"
	depends on BSD_PROCESS_ACCT
	default n

config SYSCTL
	bool "Sysctl support"

config AUDIT # default omitted
	bool "Auditing support"	

config AUDITSYSCALL # default omitted
	bool "Enable system-call auditing support"
	depends on AUDIT & (X86 | PPC64 | ARCH_S390 | IA64)

config HOTPLUG
	bool "Support for hot-pluggable devices" # if omitted
	default ARCH_S390

config IKCONFIG
	bool "Kernel .config support"

config IKCONFIG_PROC
	bool "Enable access to .config through /proc/config.gz"
	depends on IKCONFIG & PROC_FS

menuconfig EMBEDDED
	bool "Configure standard kernel features (for small systems)"

config KALLSYMS # visibility if omitted
	bool "Load all symbols for debugging/kksymoops"
	default y

config KALLSYMS_ALL
	bool "Include all symbols in kallsyms"
	depends on DEBUG_KERNEL & KALLSYMS

config KALLSYMS_EXTRA_PASS
	bool "Do an extra kallsyms pass"
	depends on KALLSYMS

config FUTEX
	bool "Enable futex support" if EMBEDDED
	default y

config EPOLL
	bool "Enable eventpoll support" # if omitted
	default y

config CC_OPTIMIZE_FOR_SIZE # default and visibility if omitted
	bool "Optimize for size"

config SHMEM	
	bool "Use full shmem filesystem" # if omitted

endmenu

config TINY_SHMEM
	bool
	default !SHMEM

menu "Loadable module support"

config MODULES
	bool "Enable loadable module support"

config MODULE_UNLOAD
	bool "Module unloading"
	depends on MODULES

config MODULE_FORCE_UNLOAD
	bool "Forced module unloading"
	depends on MODULE_UNLOAD & EXPERIMENTAL

config OBSOLETE_MODPARM
	bool
	depends on MODULES
	default y

config MODVERSIONS
	bool "Module versioning support (EXPERIMENTAL)"
	depends on MODULES & EXPERIMENTAL

config KMOD
	bool "Automatic kernel module loading"
	depends on MODULES

config STOP_MACHINE
	bool
	default y
	depends on (SMP & MODULE_UNLOAD) | HOTPLUG_CPU

endmenu

config ARCH_S390
	bool
	default n

config DEBUG_KERNEL
	bool
	default n

config HOTPLUG_CPU
	bool
	default n

config IA64
	bool
	default n

config MMU
	bool
	default n

config NET
	bool
	default n

config PPC64
	bool
	default n

config PROC_FS
	bool
	default n

config SMP
	bool
	default n

config X86
	bool
	default n

