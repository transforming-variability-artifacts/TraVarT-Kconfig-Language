menu MENU_SCTP
	depends on INET & EXPERIMENTAL

config IP_SCTP
	tristate "The SCTP Protocol (EXPERIMENTAL)"
	select CRYPTO

config SCTP_DBG_MSG
	bool "SCTP: Debug messages"
	depends on IP_SCTP

config SCTP_DBG_OBJCNT
	bool "SCTP: Debug object counts"
	depends on IP_SCTP

choice SCTP_HMAC
	bool "SCTP: Cookie HMAC Algorithm"
	depends on IP_SCTP
	default SCTP_HMAC_MD5

config SCTP_HMAC_NONE
	bool "None"

config SCTP_HMAC_SHA1
	bool "HMAC-SHA1"

config SCTP_HMAC_MD5
	bool "HMAC-MD5"

endchoice

endmenu

config CRYPTO
	bool
	default n

config CRYPTO_HMAC
	bool
	default n

config CRYPTO_MD5
	bool
	default n

config CRYPTO_SHA1
	bool
	default n

config EXPERIMENTAL
	bool
	default n

config INET
	bool
	default n

config IPV6
	bool
	default n

