config USB_EMI62
	tristate "EMI 6|2m USB Audio interface support"
	depends on USB

config USB_EMI26
	tristate "EMI 2|6 USB Audio interface support"
	depends on USB

config USB_TIGL
	tristate "Texas Instruments Graph Link USB (aka SilverLink) cable support"
	depends on USB

config USB_AUERSWALD
	tristate "USB Auerswald ISDN support (EXPERIMENTAL)"
	depends on USB & EXPERIMENTAL

config USB_RIO500
	tristate "USB Diamond Rio500 support (EXPERIMENTAL)"
	depends on USB & EXPERIMENTAL

config USB_LEGOTOWER
	tristate "USB Lego Infrared Tower support (EXPERIMENTAL)"
	depends on USB & EXPERIMENTAL

config USB_LCD
	tristate "USB LCD driver support"
	depends on USB

config USB_LED
	tristate "USB LED driver support"
	depends on USB

config USB_CYTHERM
	tristate "Cypress USB thermometer driver support"
	depends on USB

config USB_SPEEDTOUCH
	tristate "Alcatel Speedtouch USB support"
	depends on USB & ATM
	select CRC32

config USB_PHIDGETSERVO
	tristate "USB PhidgetServo support"
	depends on USB

config USB_TEST
	tristate "USB testing driver (DEVELOPMENT)"
	depends on USB & USB_DEVICEFS & EXPERIMENTAL

config ATM
	bool
	default n

config CRC32
	bool
	default n

config EXPERIMENTAL
	bool
	default n

config USB
	bool
	default n

config USB_DEVICEFS
	bool
	default n

