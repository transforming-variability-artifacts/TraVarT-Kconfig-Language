config AGP
	tristate "/dev/agpgart (AGP Support)" if !GART_IOMMU && !M68K && !ARM
	default y # if omitted

config AGP_ALI
	tristate "ALI chipset support"
	depends on AGP & X86 & ~X86_64

config AGP_ATI
	tristate "ATI chipset support"
	depends on AGP & X86 & ~X86_64

config AGP_AMD
	tristate "AMD Irongate, 761, and 762 chipset support"
	depends on AGP & X86 & ~X86_64

config AGP_AMD64
	tristate "AMD Opteron/Athlon64 on-CPU GART support" if !GART_IOMMU
	depends on AGP & X86
	default y # if omitted

config AGP_INTEL
	tristate "Intel 440LX/BX/GX, I8xx and E7x05 chipset support"
	depends on AGP & X86 & ~X86_64

config AGP_INTEL_MCH
	tristate "Intel i865 chipset support"
	depends on AGP & X86

config AGP_NVIDIA
	tristate "NVIDIA nForce/nForce2 chipset support"
	depends on AGP & X86 & ~X86_64

config AGP_SIS
	tristate "SiS chipset support"
	depends on AGP & X86 & ~X86_64

config AGP_SWORKS
	tristate "Serverworks LE/HE chipset support"
	depends on AGP & X86 & ~X86_64

config AGP_VIA
	tristate "VIA chipset support"
	depends on AGP & X86 & ~X86_64

config AGP_I460
	tristate "Intel 460GX chipset support"
	depends on AGP & (IA64_DIG | IA64_GENERIC)

config AGP_HP_ZX1
	tristate "HP ZX1 chipset AGP support"
	depends on AGP & (IA64_HP_ZX1 | IA64_GENERIC)

config AGP_ALPHA_CORE
	tristate "Alpha AGP support"
	depends on AGP & (ALPHA_GENERIC | ALPHA_TITAN | ALPHA_MARVEL)
	default AGP

config AGP_UNINORTH
	tristate "Apple UniNorth AGP support"
	depends on AGP & PPC_PMAC

config AGP_EFFICEON
	tristate "Transmeta Efficeon support"
	depends on AGP & X86 & ~X86_64

config ALPHA_GENERIC
	bool
	default n

config ALPHA_MARVEL
	bool
	default n

config ALPHA_TITAN
	bool
	default n

config IA64_DIG
	bool
	default n

config IA64_GENERIC
	bool
	default n

config IA64_HP_ZX1
	bool
	default n

config PPC_PMAC
	bool
	default n

config X86
	bool
	default n

config X86_64
	bool
	default n

