config BROKEN
	bool
	default n

config ISA
	bool
	default n

config ISAPNP
	bool
	default n

config PPC
	bool
	default n

config SND
	bool
	default n

config SND_HWDEP
	bool
	default n

config SND_MPU401_UART
	bool
	default n

config SND_OPL3_LIB
	bool
	default n

config SND_OPL4_LIB
	bool
	default n

config SND_PCM
	bool
	default n

config SND_RAWMIDI
	bool
	default n

