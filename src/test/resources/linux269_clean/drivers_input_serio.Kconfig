config SERIO # Remove visibility if
	tristate "Serial i/o support"
	default y

config SERIO_I8042 # Removed visibility if
	tristate "i8042 PC Keyboard controller"
	default y
	select SERIO
	depends on ~PARISC & (~ARM | ARCH_SHARK | FOOTBRIDGE_HOST)

config SERIO_SERPORT
	tristate "Serial port line discipline"
	default y
	depends on SERIO

config SERIO_CT82C710
	tristate "ct82c710 Aux port controller"
	depends on SERIO
	depends on ~PARISC

config SERIO_Q40KBD
	tristate "Q40 keyboard controller"
	depends on Q40 & SERIO

config SERIO_PARKBD
	tristate "Parallel port keyboard adapter"
	depends on SERIO & PARPORT

config SERIO_RPCKBD
	tristate "Acorn RiscPC keyboard controller"
	depends on (ARCH_ACORN | ARCH_CLPS7500) & SERIO
	default y

config SERIO_AMBAKMI
	tristate "AMBA KMI keyboard controller"
	depends on ARM_AMBA & SERIO

config SERIO_SA1111
	tristate "Intel SA1111 keyboard controller"
	depends on SA1111 & SERIO

config SERIO_GSCPS2
	tristate "HP GSC PS/2 keyboard and PS/2 mouse controller"
	depends on GSC & SERIO
	default y

config SERIO_PCIPS2
	tristate "PCI PS/2 keyboard and PS/2 mouse controller"
	depends on PCI & SERIO

config SERIO_MACEPS2
	tristate "SGI O2 MACE PS/2 controller"
	depends on SGI_IP32 & SERIO

config SERIO_RAW
	tristate "Raw access to serio ports"
	depends on SERIO

config ARCH_ACORN
	bool
	default n

config ARCH_CLPS7500
	bool
	default n

config ARCH_SHARK
	bool
	default n

config ARM
	bool
	default n

config ARM_AMBA
	bool
	default n

config FOOTBRIDGE_HOST
	bool
	default n

config GSC
	bool
	default n

config PARISC
	bool
	default n

config PARPORT
	bool
	default n

config PCI
	bool
	default n

config Q40
	bool
	default n

config SA1111
	bool
	default n

config SGI_IP32
	bool
	default n

