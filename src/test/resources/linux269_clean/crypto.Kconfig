menu MENU_CRYPTO

config CRYPTO
	bool "Cryptographic API"

config CRYPTO_HMAC
	bool "HMAC support"
	depends on CRYPTO

config CRYPTO_NULL
	tristate "Null algorithms"
	depends on CRYPTO

config CRYPTO_MD4
	tristate "MD4 digest algorithm"
	depends on CRYPTO

config CRYPTO_MD5
	tristate "MD5 digest algorithm"
	depends on CRYPTO

config CRYPTO_SHA1
	tristate "SHA1 digest algorithm"
	depends on CRYPTO

config CRYPTO_SHA1_Z990
	tristate "SHA1 digest algorithm for IBM zSeries z990"
	depends on CRYPTO & ARCH_S390

config CRYPTO_SHA256
	tristate "SHA256 digest algorithm"
	depends on CRYPTO

config CRYPTO_SHA512
	tristate "SHA384 and SHA512 digest algorithms"
	depends on CRYPTO

config CRYPTO_WP512
	tristate "Whirlpool digest algorithms"
	depends on CRYPTO

config CRYPTO_DES
	tristate "DES and Triple DES EDE cipher algorithms"
	depends on CRYPTO

config CRYPTO_DES_Z990
	tristate "DES and Triple DES cipher algorithms for IBM zSeries z990"
	depends on CRYPTO & ARCH_S390

config CRYPTO_BLOWFISH
	tristate "Blowfish cipher algorithm"
	depends on CRYPTO

config CRYPTO_TWOFISH
	tristate "Twofish cipher algorithm"
	depends on CRYPTO

config CRYPTO_SERPENT
	tristate "Serpent cipher algorithm"
	depends on CRYPTO

config CRYPTO_AES
	tristate "AES cipher algorithms"
	depends on CRYPTO & ~(X86 & ~X86_64)

config CRYPTO_AES_586
	tristate "AES cipher algorithms (i586)"
	depends on CRYPTO & (X86 & ~X86_64)

config CRYPTO_CAST5
	tristate "CAST5 (CAST-128) cipher algorithm"
	depends on CRYPTO

config CRYPTO_CAST6
	tristate "CAST6 (CAST-256) cipher algorithm"
	depends on CRYPTO

config CRYPTO_TEA
	tristate "TEA and XTEA cipher algorithms"
	depends on CRYPTO

config CRYPTO_ARC4
	tristate "ARC4 cipher algorithm"
	depends on CRYPTO

config CRYPTO_KHAZAD
	tristate "Khazad cipher algorithm"
	depends on CRYPTO

config CRYPTO_DEFLATE
	tristate "Deflate compression algorithm"
	depends on CRYPTO
	select ZLIB_INFLATE & ZLIB_DEFLATE

config CRYPTO_MICHAEL_MIC
	tristate "Michael MIC keyed digest algorithm"
	depends on CRYPTO

config CRYPTO_CRC32C
	tristate "CRC32c CRC algorithm"
	depends on CRYPTO
	select LIBCRC32C

config CRYPTO_TEST
	tristate "Testing module"
	depends on CRYPTO

endmenu

config ARCH_S390
	bool
	default n

config LIBCRC32C
	bool
	default n

config X86
	bool
	default n

config X86_64
	bool
	default n

config ZLIB_DEFLATE
	bool
	default n

config ZLIB_INFLATE
	bool
	default n

