menu MENU_NAND
	depends on MTD

config MTD_NAND
	tristate "NAND Device Support"
	depends on MTD

config MTD_NAND_VERIFY_WRITE
	bool "Verify NAND page writes"
	depends on MTD_NAND

config MTD_NAND_AUTCPU12
	tristate "SmartMediaCard on autronix autcpu12 board"
	depends on ARM & MTD_NAND & ARCH_AUTCPU12

config MTD_NAND_EDB7312
	tristate "Support for Cirrus Logic EBD7312 evaluation board"
	depends on ARM & MTD_NAND & ARCH_EDB7312

config MTD_NAND_SPIA
	tristate "NAND Flash device on SPIA board"
	depends on ARM & ARCH_P720T & MTD_NAND

config MTD_NAND_TOTO
	tristate "NAND Flash device on TOTO board"
	depends on ARM & ARCH_OMAP & MTD_NAND

config MTD_NAND_IDS
	tristate
	default m # Complex default with if omitted

config MTD_NAND_TX4925NDFMC
	tristate "SmartMedia Card on Toshiba RBTX4925 reference board"
	depends on TOSHIBA_RBTX4925 & MTD_NAND & TOSHIBA_RBTX4925_MPLEX_NAND

config MTD_NAND_TX4938NDFMC
	tristate "NAND Flash device on Toshiba RBTX4938 reference board"
	depends on TOSHIBA_RBTX4938 & MTD_NAND & TOSHIBA_RBTX4938_MPLEX_NAND 

config MTD_NAND_AU1550
	tristate "Au1550 NAND support"
	depends on SOC_AU1550 & MTD_NAND

config MTD_NAND_PPCHAMELEONEVB
	tristate "NAND Flash device on PPChameleonEVB board"
	depends on PPCHAMELEONEVB & MTD_NAND

config MTD_NAND_DISKONCHIP
	tristate "DiskOnChip 2000, Millennium and Millennium Plus (NAND reimplementation) (EXPERIMENTAL)"
	depends on MTD_NAND & EXPERIMENTAL

config MTD_NAND_DISKONCHIP_PROBE_ADVANCED
	bool "Advanced detection options for DiskOnChip"
	depends on MTD_NAND_DISKONCHIP

config MTD_NAND_DISKONCHIP_PROBE_HIGH
	bool "Probe high addresses"
	depends on MTD_NAND_DISKONCHIP_PROBE_ADVANCED

config MTD_NAND_DISKONCHIP_BBTWRITE
	bool "Allow BBT writes on DiskOnChip Millennium and 2000TSOP"
	depends on MTD_NAND_DISKONCHIP

endmenu

config ARCH_AUTCPU12
	bool
	default n

config ARCH_EDB7312
	bool
	default n

config ARCH_OMAP
	bool
	default n

config ARCH_P720T
	bool
	default n

config ARM
	bool
	default n

config EXPERIMENTAL
	bool
	default n

config MTD
	bool
	default n

config PPCHAMELEONEVB
	bool
	default n

config SOC_AU1550
	bool
	default n

config TOSHIBA_RBTX4925
	bool
	default n

config TOSHIBA_RBTX4925_MPLEX_NAND
	bool
	default n

config TOSHIBA_RBTX4938
	bool
	default n

config TOSHIBA_RBTX4938_MPLEX_NAND
	bool
	default n

