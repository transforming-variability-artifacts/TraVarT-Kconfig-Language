	bool
	default n

config UID16
	bool
	default y

config RWSEM_GENERIC_SPINLOCK
	bool
	default y

config RWSEM_XCHGADD_ALGORITHM
	bool
	default n

menu MENU_CPU

choice CPU_TYPE
	bool "CPU"
	default M68EZ328

config M68328
	bool "MC68328"

config M68EZ328
	bool "MC68EZ328"

config M68VZ328
	bool "MC68VZ328"

config M68360
	bool "MC68360"

config M5206
	bool "MCF5206"

config M5206e
	bool "MCF5206e"

config M5249
	bool "MCF5249"

config M5272
	bool "MCF5272"

config M5282
	bool "MCF5282"

config M5307
	bool "MCF5307"

config M5407
	bool "MCF5407"

endchoice

config COLDFIRE
	bool
	depends on (M5206 | M5206e | M5249 | M5272 | M5282 | M5307 | M5407)
	default y

choice CLOCK_FREQ
	bool "CPU CLOCK Frequency"
	default AUTO

config CLOCK_AUTO
	bool "AUTO"

config CLOCK_11MHz
	bool "11MHz"

config CLOCK_16MHz
	bool "16MHz"

config CLOCK_20MHz
	bool "20MHz"

