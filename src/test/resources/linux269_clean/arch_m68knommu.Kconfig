config ROMFS_FROM_ROM
	bool "  ROMFS image not RAM resident"
	depends on (NETtel | SNAPGEAR)

config PILOT
	bool
	default y
	depends on (PILOT3 | PILOT5)

config ARNEWSH
	bool
	default y
	depends on (ARN5206 | ARN5307)

config MOTOROLA
	bool
	default y
	depends on (M5206eC3 | M5249C3 | M5272C3 | M5282C3 | M5307C3 | M5407C3)

config senTec
	bool
	default y
	depends on (COBRA5272 | COBRA5282)

config LARGE_ALLOCS
	bool "Allow allocating large blocks (> 1MB) of memory"

choice RAMSIZE
	bool "RAM size"
	default AUTO

config RAMAUTO
	bool "AUTO"

config RAM4MB
	bool "4MiB"

config RAM8MB
	bool "8MiB"

config RAM16MB
	bool "16MiB"

config RAM32MB
	bool "32MiB"

endchoice

choice RAMBIT
	bool "RAM bus width"
	default RAMAUTOBIT

config RAMAUTOBIT
	bool "AUTO"

config RAM8BIT
	bool "8bit"

config RAM16BIT
	bool "16bit"

config RAM32BIT
	bool "32bit"

endchoice

choice KERNELFROM
	bool "Kernel executes from"

config RAMKERNEL
	bool "RAM"

config ROMKERNEL
	bool "ROM"

config HIMEMKERNEL
	bool "HIMEM"

endchoice

