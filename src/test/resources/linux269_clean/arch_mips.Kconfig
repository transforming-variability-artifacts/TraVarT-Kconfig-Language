# Lots of manual fixes in this file
# All edits may have not been consequently commented!
# a.o.: Omission of multiple default statements, auxiliary if statements

config MIPS
	bool
	default y
	select EMBEDDED

config MIPS64
	bool "64-bit kernel"
	select ARCH_64BIT

config ARCH_64BIT
	bool

config MIPS32
	bool
	depends on ~MIPS64
	default y

mainmenu MENU_ARCH_MIPS

menu MENU_MACH

config MACH_JAZZ
	bool "Support for the Jazz family of machines"
	select ISA

