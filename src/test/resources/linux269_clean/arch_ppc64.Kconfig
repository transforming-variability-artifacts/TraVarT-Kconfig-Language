# Renamed to ARCH_*, def_bool -> bool
config ARCH_64BIT
	bool
	default y

config MMU
	bool
	default y

config UID16
	bool

config RWSEM_GENERIC_SPINLOCK
	bool

config RWSEM_XCHGADD_ALGORITHM
	bool
	default y

config GENERIC_ISA_DMA
	bool
	default y

config HAVE_DEC_LOCK
	bool
	default y

config EARLY_PRINTK
	bool
	default y

config COMPAT
	bool
	default y

config FRAME_POINTER
	bool
	default y

config SYSVIPC_COMPAT
	bool
	depends on COMPAT & SYSVIPC
	default y

menu MENU_PLATFORM

choice PLATFORM_TYPE
	bool "Platform Type"
	default PPC_MULTIPLATFORM

config PPC_ISERIES
	bool "IBM Legacy iSeries"

config PPC_MULTIPLATFORM
	bool "Generic"

endchoice

config PPC_PSERIES
	bool "  IBM pSeries & new iSeries"
	depends on PPC_MULTIPLATFORM
	default y

config PPC_PMAC
	bool "  Apple G5 based machines"
	depends on PPC_MULTIPLATFORM
	default y
	select ADB_PMU & U3_DART

config PPC
	bool
	default y

config PPC64
	bool
	default y

config PPC_OF
	bool
	depends on PPC_MULTIPLATFORM
	default y

config ALTIVEC
	bool "Support for VMX (Altivec) vector unit"
	depends on PPC_MULTIPLATFORM
	default y

config PPC_SPLPAR
	bool "Support for shared-processor logical partitions"
	depends on PPC_PSERIES
	default n

config U3_DART
	bool 
	depends on PPC_MULTIPLATFORM
	default n

config PPC_PMAC64
	bool
	depends on PPC_PMAC
	default y

config BOOTX_TEXT
	bool "Support for early boot text console"
	depends on PPC_OF

config POWER4_ONLY
	bool "Optimize for POWER4"
	default n

config IOMMU_VMERGE
	bool "Enable IOMMU virtual merging (EXPERIMENTAL)"
	depends on EXPERIMENTAL
	default n

config SMP
	bool "Symmetric multi-processing support"

config IRQ_ALL_CPUS
	bool "Distribute interrupts on all CPUs by default"
	depends on SMP & PPC_MULTIPLATFORM

config HMT
	bool "Hardware multithreading"
	depends on SMP & PPC_PSERIES

config DISCONTIGMEM
	bool "Discontiguous Memory Support"
	depends on SMP & PPC_PSERIES

config NUMA
	bool "NUMA support"
	depends on DISCONTIGMEM

config SCHED_SMT
	bool "SMT (Hyperthreading) scheduler support"
	depends on SMP
	default n

config PREEMPT
	bool "Preemptible Kernel"

config MSCHUNKS
	bool
	depends on PPC_ISERIES
	default y

config PPC_RTAS
	bool "Proc interface to RTAS"
	depends on PPC_PSERIES

config RTAS_FLASH
	tristate "Firmware flash interface"
	depends on PPC_RTAS

config SCANLOG
	tristate "Scanlog dump interface"
	depends on PPC_RTAS

config LPARCFG
	tristate "LPAR Configuration Data"
	depends on PPC_PSERIES | PPC_ISERIES

endmenu

menu MENU_GENERAL

config ISA
	bool

config SBUS
	bool

config MCA
	bool

config EISA
	bool

config PCI
	bool
	default y

config PCI_DOMAINS
	bool
	default PCI

config HOTPLUG_CPU
	bool "Support for hot-pluggable CPUs"
	depends on SMP & HOTPLUG & EXPERIMENTAL & PPC_PSERIES

config PROC_DEVICETREE
	bool "Support for Open Firmware device tree in /proc"
	depends on ~PPC_ISERIES

config CMDLINE_BOOL
	bool "Default bootloader kernel arguments"
	depends on ~PPC_ISERIES

endmenu

config MENU_ISERIES_DUMMY
	bool
	default n

# Buggy roundtrip: PPC_ISERIES is inside a choice block, direct dependency
# Menu may end up enclosed inside PPC_ISERIES
# Use above dummy confsym to ensure enclosure doesn't happen
menu MENU_ISERIES
	depends on PPC_ISERIES & MENU_ISERIES_DUMMY

config VIOCONS
	tristate "iSeries Virtual Console Support"

config VIODASD
	tristate "iSeries Virtual I/O disk support"

config VIOCD
	tristate "iSeries Virtual I/O CD support"

config VIOTAPE
	tristate "iSeries Virtual Tape Support"

endmenu

config VIOPATH
	bool
	depends on VIOCONS | VIODASD | VIOCD | VIOTAPE | VETH
	default y

config ADB_PMU
	bool
	default n

config EXPERIMENTAL
	bool
	default n

config HOTPLUG
	bool
	default n

config SYSVIPC
	bool
	default n

config VETH
	bool
	default n

