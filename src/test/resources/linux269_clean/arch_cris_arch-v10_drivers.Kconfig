	bool "No DMA in"

config CONFIG_ETRAX_SERIAL_PORT3_DMA5_IN
	bool "DMA 5"

endchoice

choice ETRAX_SER3_DTR_RI_DSR_CD
	bool "Ser3 DTR, RI, DSR and CD assignment"
	depends on ETRAX_SERIAL_PORT3
	default ETRAX_SER3_DTR_RI_DSR_CD_ON_NONE

