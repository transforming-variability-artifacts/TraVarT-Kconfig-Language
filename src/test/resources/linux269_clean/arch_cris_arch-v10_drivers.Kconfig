endchoice

# Dummy symbol to avoid enclosure bug

config ETRAX_DS1302_RST_ON_GENERIC_PORT_DUMMY
	bool
	default y

config ETRAX_DS1302_RST_ON_GENERIC_PORT
	bool "DS1302 RST on Generic Port"
