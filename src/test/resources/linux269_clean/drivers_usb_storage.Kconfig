config USB_STORAGE
	tristate "USB Mass Storage support"
	depends on USB
	select SCSI

config USB_STORAGE_DEBUG
	bool "USB Mass Storage verbose debug"
	depends on USB_STORAGE

config USB_STORAGE_RW_DETECT
	bool "USB Mass Storage Write-Protected Media Detection (EXPERIMENTAL)"
	depends on USB_STORAGE & EXPERIMENTAL

config USB_STORAGE_DATAFAB
	bool "Datafab Compact Flash Reader support (EXPERIMENTAL)"
	depends on USB_STORAGE & EXPERIMENTAL

config USB_STORAGE_FREECOM
	bool "Freecom USB/ATAPI Bridge support"
	depends on USB_STORAGE

config USB_STORAGE_ISD200
	bool "ISD-200 USB/ATA Bridge support"
	depends on USB_STORAGE & BLK_DEV_IDE

config USB_STORAGE_DPCM
	bool "Microtech/ZiO! CompactFlash/SmartMedia support"
	depends on USB_STORAGE

config USB_STORAGE_HP8200e
	bool "HP CD-Writer 82xx support (EXPERIMENTAL)"
	depends on USB_STORAGE & EXPERIMENTAL

config USB_STORAGE_SDDR09
	bool "SanDisk SDDR-09 (and other SmartMedia) support (EXPERIMENTAL)"
	depends on USB_STORAGE & EXPERIMENTAL

config USB_STORAGE_SDDR55
	bool "SanDisk SDDR-55 SmartMedia support (EXPERIMENTAL)"
	depends on USB_STORAGE & EXPERIMENTAL

config USB_STORAGE_JUMPSHOT
	bool "Lexar Jumpshot Compact Flash Reader (EXPERIMENTAL)"
	depends on USB_STORAGE & EXPERIMENTAL

config BLK_DEV_IDE
	bool
	default n

config EXPERIMENTAL
	bool
	default n

config SCSI
	bool
	default n

config USB
	bool
	default n

