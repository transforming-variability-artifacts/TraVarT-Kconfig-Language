# File adapted after automatic reduction

config ZFTAPE
	tristate "Zftape, the VFS interface"
	depends on FTAPE

config ZFT_COMPRESSOR
	tristate
	depends on FTAPE & ZFTAPE
	default m

config FT_PROC_FS
	bool "Enable procfs status report (+2kb)"
	depends on FTAPE & PROC_FS

choice FT_DEBUG
	bool "Debugging output"
	depends on FTAPE
	default FT_NORMAL_DEBUG

config FT_NORMAL_DEBUG
	bool "Normal"

config FT_FULL_DEBUG
	bool "Excessive"

config FT_NO_TRACE
	bool "Reduced"

config FT_NO_TRACE_AT_ALL
	bool "None"

endchoice

choice FT_CTRL
	bool "Floppy tape controllers"
	depends on FTAPE
	default FT_STD_FDC

config FT_STD_FDC
	bool "Standard"

config FT_MACH2
	bool "MACH-2"

config FT_PROBE_FC10
	bool "FC-10/FC-20"

config FT_ALT_FDC
	bool "Alt/82078"

endchoice

config EXPERIMENTAL
	bool
	default n

config FTAPE
	bool
	default n

config PROC_FS
	bool
	default n

