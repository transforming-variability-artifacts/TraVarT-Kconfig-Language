mainmenu LKC_SPARC

config MMU
	bool
	default y

config UID16
	bool
	default y

config HIGHMEM
	bool
	default y

config GENERIC_ISA_DMA
	bool
	default y

menu MENU_GENERAL

config VT
	bool
	default y

config VT_CONSOLE
	bool
	default y

config HW_CONSOLE
	bool
	default y

config SMP
	bool "Symmetric multi-processing support (does not work on sun4/sun4c)"
	depends on BROKEN

config SPARC32
	bool
	default y

config ISA
	bool

config EISA
	bool

config MCA
	bool

config PCMCIA
	tristate

config SBUS
	bool
	default y

config SBUSCHAR
	bool
	default y

config SERIAL_CONSOLE
	bool
	default y

config SUN_AUXIO
	bool
	default y

config SUN_IO
	bool
	default y

config RWSEM_GENERIC_SPINLOCK
	bool
	default y

config RWSEM_XCHGADD_ALGORITHM
	bool

config SUN_PM
	bool
	default y

config SUN4
	bool "Support for SUN4 machines (disables SUN4[CDM] support)"
	depends on ~SMP

if ~SUN4

config PCI
	bool "Support for PCI and PS/2 keyboard/mouse"

endif

config SUN_OPENPROMFS
	tristate "Openprom tree appears in /proc/openprom"

config SUNOS_EMUL
	bool "SunOS binary emulation"

config PRINTER
	tristate "Parallel printer support"
	depends on PARPORT

endmenu

menu MENU_UNIX98_PTYS

config UNIX98_PTYS
	bool "Unix98 PTY support"

endmenu

config BROKEN
	bool
	default n

config PARPORT
	bool
	default n

