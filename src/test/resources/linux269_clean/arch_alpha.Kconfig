config ALPHA
	bool
	default y

config 64BIT
	bool
	default y

config MMU
	bool
	default y

config UID16
	bool

config RWSEM_GENERIC_SPINLOCK
	bool

config RWSEM_XCHGADD_ALGORITHM
	bool
	default y

config GENERIC_ISA_DMA
	bool
	default y

config GENERIC_IOMAP
	bool
	default n

menu MENU_SYSTEM

choice ALPHA_TYPE
	bool "Alpha system type"
	default ALPHA_GENERIC

config ALPHA_GENERIC
	bool "Generic"

config ALPHA_ALCOR
	bool "Alcor/Alpha-XLT"

config ALPHA_XL
	bool "Alpha-XL"

config ALPHA_BOOK1
	bool "AlphaBook1"

config ALPHA_AVANTI_CH
	bool "Avanti"

config ALPHA_CABRIOLET
	bool "Cabriolet"

config ALPHA_DP264
	bool "DP264"

config ALPHA_EB164
	bool "EB164"

config ALPHA_EB64P_CH
	bool "EB64+"

config ALPHA_EB66
	bool "EB66"

config ALPHA_EB66P
	bool "EB66+"

config ALPHA_EIGER
	bool "Eiger"

config ALPHA_JENSEN
	bool "Jensen"

config ALPHA_LX164
	bool "LX164"

config ALPHA_LYNX
	bool "Lynx"

config ALPHA_MARVEL
	bool "Marvel"

config ALPHA_MIATA
	bool "Miata"

config ALPHA_MIKASA
	bool "Mikasa"

config ALPHA_NAUTILUS
	bool "Nautilus"

config ALPHA_NONAME_CH
	bool "Noname"

config ALPHA_NORITAKE
	bool "Noritake"

config ALPHA_PC164
	bool "PC164"

config ALPHA_P2K
	bool "Platform2000"

config ALPHA_RAWHIDE
	bool "Rawhide"

config ALPHA_RUFFIAN
	bool "Ruffian"

config ALPHA_RX164
	bool "RX164"

config ALPHA_SX164
	bool "SX164"

config ALPHA_SABLE
	bool "Sable"

config ALPHA_SHARK
	bool "Shark"

config ALPHA_TAKARA
	bool "Takara"

config ALPHA_TITAN
	bool "Titan"

config ALPHA_WILDFIRE
	bool "Wildfire"

endchoice

config ISA
	bool
	default y

config PCI
	bool
	depends on ~ALPHA_JENSEN
	default y

config PCI_DOMAINS
	bool
	default y

config ALPHA_CORE_AGP
	bool
	depends on ALPHA_GENERIC | ALPHA_TITAN | ALPHA_MARVEL
	default y

config ALPHA_NONAME
	bool
	depends on ALPHA_BOOK1 | ALPHA_NONAME_CH
	default y

# Auxiliary if in default value statement removed
config ALPHA_EV4
	bool
	depends on ALPHA_JENSEN | (ALPHA_SABLE & ~ALPHA_GAMMA) | ALPHA_LYNX | ALPHA_NORITAKE & ~ALPHA_PRIMO | ALPHA_MIKASA & ~ALPHA_PRIMO | ALPHA_CABRIOLET | ALPHA_AVANTI_CH | ALPHA_EB64P_CH | ALPHA_XL | ALPHA_NONAME | ALPHA_EB66 | ALPHA_EB66P | ALPHA_P2K
	default y

config ALPHA_LCA
	bool
	depends on ALPHA_NONAME | ALPHA_EB66 | ALPHA_EB66P | ALPHA_P2K
	default y

config ALPHA_APECS
	bool
	depends on ~ALPHA_PRIMO & (ALPHA_NORITAKE | ALPHA_MIKASA) | ALPHA_CABRIOLET | ALPHA_AVANTI_CH | ALPHA_EB64P_CH | ALPHA_XL
	default y

config ALPHA_EB64P
	bool
	depends on ALPHA_CABRIOLET | ALPHA_EB64P_CH
	default y

# Auxiliary if in default statement removed
config ALPHA_EV5
	bool "EV5 CPU(s) (model 5/xxx)?" if ALPHA_LYNX
	default y

# Duplicated symbol
# Auxiliary if in default statement removed
config ALPHA_EV4_DUP
	bool
	default y

config ALPHA_CIA
	bool
	depends on ALPHA_MIATA | ALPHA_LX164 | ALPHA_SX164 | ALPHA_RUFFIAN | ALPHA_NORITAKE & ALPHA_PRIMO | ALPHA_MIKASA & ALPHA_PRIMO | ALPHA_PC164 | ALPHA_TAKARA | ALPHA_EB164 | ALPHA_ALCOR
	default y

# Auxiliary if in visibility and default statement removed
config ALPHA_EV56
	bool "EV56 CPU (speed >= 366MHz)?"
	default y

config ALPHA_PRIMO
	bool "EV5 CPU daughtercard (model 5/xxx)?"
	depends on ALPHA_NORITAKE | ALPHA_MIKASA

config ALPHA_GAMMA
	bool "EV5 CPU(s) (model 5/xxx)?"
	depends on ALPHA_SABLE

# Duplicated symbol
config ALPHA_GAMMA_DUP
	bool
	depends on ALPHA_LYNX
	default y

config ALPHA_T2
	bool
	depends on ALPHA_SABLE | ALPHA_LYNX
	default y

config ALPHA_PYXIS
	bool
	depends on ALPHA_MIATA | ALPHA_LX164 | ALPHA_SX164 | ALPHA_RUFFIAN
	default y

config ALPHA_EV6
	bool
	depends on ALPHA_NAUTILUS | ALPHA_WILDFIRE | ALPHA_TITAN | ALPHA_SHARK | ALPHA_DP264 | ALPHA_EIGER | ALPHA_MARVEL
	default y

config ALPHA_TSUNAMI
	bool
	depends on ALPHA_SHARK | ALPHA_DP264 | ALPHA_EIGER
	default y

# Auxiliary ifs removed
config ALPHA_EV67
	bool "EV67 (or later) CPU (speed > 600MHz)?"
	default y

config ALPHA_EV7
	bool
	depends on ALPHA_MARVEL
	default y

config ALPHA_MCPCIA
	bool
	depends on ALPHA_RAWHIDE
	default y

config ALPHA_POLARIS
	bool
	depends on ALPHA_RX164
	default y

config ALPHA_IRONGATE
	bool
	depends on ALPHA_NAUTILUS
	default y

config ALPHA_AVANTI
	bool
	depends on ALPHA_XL | ALPHA_AVANTI_CH
	default y

config ALPHA_BROKEN_IRQ_MASK
	bool
	depends on ALPHA_GENERIC | ALPHA_PC164
	default y

# Auxiliary ifs removed
config ALPHA_SRM
	bool "Use SRM as bootloader"
	default y

config EISA
	bool
	depends on ALPHA_GENERIC | ALPHA_JENSEN | ALPHA_ALCOR | ALPHA_MIKASA | ALPHA_SABLE | ALPHA_LYNX | ALPHA_NORITAKE | ALPHA_RAWHIDE
	default y

config SMP
	bool "Symmetric multi-processing support"
	depends on ALPHA_SABLE | ALPHA_LYNX | ALPHA_RAWHIDE | ALPHA_DP264 | ALPHA_WILDFIRE | ALPHA_TITAN | ALPHA_GENERIC | ALPHA_SHARK | ALPHA_MARVEL

config HAVE_DEC_LOCK
	bool
	depends on SMP
	default y

config DISCONTIGMEM
	bool "Discontiguous Memory Support (EXPERIMENTAL)"
	depends on EXPERIMENTAL

config NUMA
	bool "NUMA Support (EXPERIMENTAL)"
	depends on DISCONTIGMEM

config ALPHA_LARGE_VMALLOC
	bool

config VERBOSE_MCHECK
	bool "Verbose Machine Checks"

config SRM_ENV
	tristate "SRM environment through procfs"
	depends on PROC_FS

endmenu

config EXPERIMENTAL
	bool
	default n

config PROC_FS
	bool
	default n

